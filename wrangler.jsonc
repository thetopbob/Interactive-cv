{
	"name": "interactive-cv",
	"compatibility_date": "2026-09-03",
	"assets": {
		"directory": ".",
		"not_found_handling": "single-page-application"
	},
    "observability": {
    "enabled": false,
    "head_sampling_rate": 1,
    "redact_query_string": false,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": false,
      "persist": true,
      "head_sampling_rate": 1
    }
  }
}
